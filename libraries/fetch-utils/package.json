{
  "name": "@overleaf/fetch-utils",
  "version": "0.1.0",
  "description": "utilities for node-fetch",
  "main": "index.ts",
  "exports": {
    "import": "./index.ts",
    "require": "./index.ts",
    "default": "./index.ts"
  },
  "type": "module",
  "scripts": {
    "test": "yarn run lint && yarn run types:check && yarn run test:unit",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --ext .cjs,.js,.jsx,.mjs,.ts --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix --ext .cjs,.js,.jsx,.mjs,.ts .",
    "test:ci": "yarn run test:unit",
    "test:unit": "vitest --config vitest.config.ts",
    "types:check": "tsc --noEmit"
  },
  "author": "Overleaf (https://www.overleaf.com)",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.5.2",
    "@types/node-fetch": "^2.6.13",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "eslint": "^10.4.0",
    "express": "4.22.1",
    "selfsigned": "^5.5.0",
    "typescript": "^5.0.4",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@overleaf/o-error": "workspace:*",
    "lodash": "^4.18.1",
    "node-fetch": "^2.7.0"
  }
}
