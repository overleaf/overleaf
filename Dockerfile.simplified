# =====================================================
# Simplified Overleaf - All-in-One Container
# =====================================================
# Bases on the pre-compiled sharelatex/sharelatex:latest,
# which already contains all 11 microservices, TeX Live,
# nginx, and the Phusion my_init/runit setup.
#
# This layer adds:
# - MongoDB 8.0  (embedded, single container)
# - Redis        (embedded)
# - Auto LaTeX package installation via tlmgr
# =====================================================

ARG OVERLEAF_TAG=sharelatex/sharelatex:latest
FROM $OVERLEAF_TAG

# Install MongoDB 8.0 (Ubuntu 24.04 Noble compatible) and Redis
# -------------------------------------------------------------
RUN apt-get update \
 && apt-get install -y gnupg curl \
 && curl -fsSL https://www.mongodb.org/static/pgp/server-8.0.asc \
      | gpg --dearmor -o /usr/share/keyrings/mongodb-server-8.0.gpg \
 && echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg ] https://repo.mongodb.org/apt/ubuntu noble/mongodb-org/8.0 multiverse" \
      > /etc/apt/sources.list.d/mongodb-org-8.0.list \
 && apt-get update \
 && apt-get install -y \
      mongodb-org-server \
      mongodb-org-mongos \
      mongodb-mongosh \
      redis-server \
 && rm -rf /var/lib/apt/lists/*

# Add DB startup + readiness init script (runs before other init scripts)
# -----------------------------------------------------------------------
# Note: starts mongod --fork and redis-server --daemonize, then waits.
# Runit services are NOT used for mongod/redis to avoid process conflicts.
COPY server-ce/init_scripts/010_wait_for_embedded_dbs.sh /etc/my_init.d/010_wait_for_embedded_dbs.sh
RUN sed -i 's/\r$//' /etc/my_init.d/010_wait_for_embedded_dbs.sh \
 && chmod +x /etc/my_init.d/010_wait_for_embedded_dbs.sh

# Override CLSI source with auto-install-packages support
# -------------------------------------------------------
COPY services/clsi/app/js/CompileManager.js /overleaf/services/clsi/app/js/CompileManager.js
COPY services/clsi/app/js/LatexMetrics.js /overleaf/services/clsi/app/js/LatexMetrics.js
COPY services/clsi/config/settings.defaults.cjs /overleaf/services/clsi/config/settings.defaults.cjs

# Create data directories (overleaf dir already exists; add mongo/redis)
# -----------------------------------------------------------------------
RUN mkdir -p /var/lib/mongodb /var/lib/redis /var/lib/texlive/texmf-local \
 && chown -R mongodb:mongodb /var/lib/mongodb

# Configure TeX Live for on-demand package installation
# Allow www-data (the CLSI process user) to install packages via tlmgr
# -----------------------------------------------------
# The base image tracks upstream and rolled TeX Live 2025 -> 2026, so the year
# is detected rather than hardcoded.
#
# Repository choice matters: tlmgr refuses a repository whose TeX Live version
# differs from the local install, and the ROLLING `tlnet` additionally refuses
# to install anything once its tlmgr is newer than the local one ("tlmgr itself
# needs to be updated"). Either failure makes auto-install silently fall back to
# writing empty stub .sty files, so documents compile without the real package.
# A frozen snapshot avoids both and keeps builds reproducible.
# Verified against this image's tlmgr r78616 (2026-04-06).
ARG TLNET_YEAR=2026
ARG TLNET_REPO=https://www.texlive.info/tlnet-archive/2026/06/15/tlnet

RUN set -eu; \
    TLDIR="$(ls -1d /usr/local/texlive/[0-9][0-9][0-9][0-9] | sort -r | head -1)"; \
    TLYEAR="$(basename "$TLDIR")"; \
    if [ "$TLYEAR" = "$TLNET_YEAR" ]; then \
      REPO="$TLNET_REPO"; \
    else \
      HIST="https://ftp.math.utah.edu/pub/tex/historic/systems/texlive/${TLYEAR}/tlnet-final/"; \
      if curl -fsI -m 20 "$HIST" >/dev/null 2>&1; then REPO="$HIST"; \
      else echo "WARNING: no pinned repo for TeX Live ${TLYEAR}; using rolling tlnet"; \
           REPO="https://mirror.ctan.org/systems/texlive/tlnet"; fi; \
    fi; \
    echo "TeX Live ${TLYEAR}; tlmgr repository = ${REPO}"; \
    mkdir -p /usr/local/texlive/texmf-local/tex/latex; \
    tlmgr option autobackup -- -1; \
    tlmgr option repository "$REPO"; \
    echo "Verifying tlmgr can install from the repository..."; \
    tlmgr install mathpartir || { \
      echo "ERROR: tlmgr cannot install from ${REPO}."; \
      echo "Auto-install would degrade to empty stub .sty files. Update TLNET_REPO."; \
      exit 1; }; \
    echo "Installing language support (German + Western European)..."; \
    tlmgr install \
      collection-langgerman \
      collection-langfrench \
      collection-langspanish \
      collection-langitalian \
      collection-langportuguese \
      babel-dutch \
      hyphen-dutch; \
    chown -R www-data:www-data "$TLDIR"; \
    chown -R www-data:www-data /usr/local/texlive/texmf-local

# Create install-tex-package helper script
# -----------------------------------------
COPY <<'EOF' /usr/local/bin/install-tex-package
#!/bin/bash
set -e
PACKAGE="$1"
if [ -z "$PACKAGE" ]; then
    echo "Usage: install-tex-package <package-name>"
    echo "       install-tex-package --list-installed"
    exit 1
fi
if [ "$PACKAGE" = "--list-installed" ]; then
    tlmgr list --only-installed
    exit 0
fi
echo "Installing LaTeX package: $PACKAGE"
tlmgr install "$PACKAGE"
texhash
echo "Package '$PACKAGE' installed successfully"
EOF
RUN chmod +x /usr/local/bin/install-tex-package

# Environment Variables
# ---------------------
# Embedded database flags (enables mongod/redis runit services)
ENV EMBEDDED_MONGO="true"
ENV EMBEDDED_REDIS="true"

# Database connections (localhost — same container, single-node replica set)
ENV OVERLEAF_MONGO_URL="mongodb://127.0.0.1:27017/sharelatex?replicaSet=overleaf"
ENV OVERLEAF_REDIS_HOST="127.0.0.1"
ENV REDIS_HOST="127.0.0.1"

# Disable sandboxed compiles (run LaTeX in same container)
ENV SANDBOXED_COMPILES="false"
ENV DOCKER_RUNNER="false"

# Enable auto-install of missing LaTeX packages during compilation
ENV AUTO_INSTALL_PACKAGES="true"

# Volumes for persistence
# -----------------------
VOLUME ["/var/lib/overleaf", "/var/lib/mongodb", "/var/lib/redis", "/var/lib/texlive/texmf-local"]

EXPOSE 80

# Use Phusion my_init (runs init scripts, then starts runit for all services)
ENTRYPOINT ["/sbin/my_init"]
