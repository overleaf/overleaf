export function latexToUnicode(value: string) {
  let s = value

  // First, replace the LaTeX commands we know about that take no argument
  //
  // A LaTeX command is one of:
  //
  // - a backslash followed by letters (\textbf) and optional spaces
  // - a backslash followed by a single non-letter (\^) and optional spaces
  s = s.replaceAll(/\\([a-zA-Z]+|[^a-zA-Z])\s*/g, noArgsReplacer)

  // Next, replace the LaTeX commands we know about that take one argument
  //
  // This first regex identifies arguments that are not inside braces. These
  // can be:
  //
  // - a single character (\'e)
  // - another LaTeX command (\^\alpha) - we don't support args for that command
  s = s.replaceAll(
    /\\([a-zA-Z]+|[^a-zA-Z])\s*([^{\\]|\\[^a-zA-Z]|[a-zA-Z]+)/g,
    singleArgReplacer
  )

  // This second regex identifies arguments inside braces. We support two levels
  // of braces. For example:
  //
  // - \'{e}
  // - \mkbibquote{\'{e}cole}
  //
  // Because we support two levels of nested braces, we also need to run this
  // twice.
  for (let i = 0; i < 2; i++) {
    s = s.replaceAll(
      /\\([a-zA-Z]+|[^a-zA-Z])\s*{([^{}]*(?:{[^{}]*}[^{}]*)*)}/g,
      singleArgReplacer
    )
  }
  return s.normalize('NFC')
}

function noArgsReplacer(match: string, command: string) {
  return NO_ARGS_REPLACEMENTS[command] ?? match
}

function singleArgReplacer(match: string, command: string, arg: string) {
  if (command === 'mkbibquote') {
    return `"${arg}"`
  }

  const replacement = SINGLE_ARG_REPLACEMENTS[command]?.[arg]
  if (replacement != null) {
    return replacement
  }

  if (arg.length === 1) {
    const combiningChar = COMBINING_CHAR_REPLACEMENTS[command]
    if (combiningChar != null) {
      return arg + combiningChar
    }
  }

  return match
}

