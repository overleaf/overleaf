+++ b/lib/lockdown.js
@@ -0,0 +1,157 @@
+/*!
+ * Overleaf request-input lockdown.
+ *
+ * Captures parsed request input in symbol-keyed fields and, when
+ * REQ_LOCKDOWN_MODE is 'warn' or 'throw', turns the public req.body,
+ * req.query and req.params properties into lockdown accessors:
+ *
+ *  - reads log a warning ('warn' mode) or throw ('throw' mode); request
+ *    input must be read through parseReq() from @overleaf/validation-tools,
+ *    which validates it against a zod schema, or through getRawReqInput()
+ *    for allowlisted middleware
+ *  - writes always work and are stored in the symbol-keyed fields, so body
+ *    parsers and middleware that assign req.body keep functioning unchanged
+ *
+ * With REQ_LOCKDOWN_MODE unset (or 'off') nothing is installed and express
+ * behaves exactly like the unpatched package.
+ *
+ * The symbols are registered in the global symbol registry so that
+ * @overleaf/validation-tools can read the raw fields without importing
+ * express internals. Express' own internals (router param processing, the
+ * query middleware, res.jsonp) go through the helpers below instead of the
+ * public properties so that only application code trips the lockdown.
+ *
+ * Note: unlike the stock properties, the locked accessors are defined
+ * non-enumerable so that iterating/serializing a request (e.g. in logging)
+ * does not trip the lockdown.
+ */
+
+'use strict';
+
+var RAW_BODY = Symbol.for('overleaf.lockdown.rawBody');
+var RAW_QUERY = Symbol.for('overleaf.lockdown.rawQuery');
+var RAW_PARAMS = Symbol.for('overleaf.lockdown.rawParams');
+var INSTALLED = Symbol.for('overleaf.lockdown.installed');
+
+var VALID_MODES = ['off', 'warn', 'throw'];
+var cachedMode = null;
+
+function mode() {
+  if (cachedMode === null) {
+    var m = process.env.REQ_LOCKDOWN_MODE || 'off';
+    cachedMode = VALID_MODES.indexOf(m) === -1 ? 'off' : m;
+  }
+  return cachedMode;
+}
+
+/**
+ * Override the mode for tests. Pass null to re-read REQ_LOCKDOWN_MODE on the
+ * next access. Only affects requests that have not been handled yet.
+ */
+function setModeForTests(m) {
+  if (m === null) {
+    cachedMode = null;
+  } else {
+    cachedMode = VALID_MODES.indexOf(m) === -1 ? 'off' : m;
+  }
+}
+
+var warned = new Set();
+
+function report(req, field) {
+  var route = req.route && req.route.path;
+  var location =
+    (req.method || 'UNKNOWN') +
+    ' ' +
+    (route || req.originalUrl || req.url || 'unknown');
+  if (mode() === 'warn') {
+    var key = location + ' ' + field;
+    if (!warned.has(key)) {
+      warned.add(key);
+      var stack = new Error('trace').stack.split('\n').slice(2, 7).join('\n');
+      console.warn(
+        'req-lockdown: raw request input read: req.' +
+          field +
+          ' at ' +
+          location +
+          '\n' +
+          stack
+      );
+    }
+    return;
+  }
+  var err = new Error(
+    'raw request input is forbidden — use parseReq() (read req.' +
+      field +
+      ' at ' +
+      location +
+      ')'
+  );
+  err.code = 'ERR_RAW_REQ_INPUT';
+  throw err;
+}
+
+/**
+ * Install the lockdown accessors on a request. Idempotent, no-op in 'off'
+ * mode. Called from the router, the query middleware and expressInit so that
+ * every request is covered no matter how the app is assembled.
+ */
+function install(req) {
+  if (mode() === 'off') return;
+  if (req[INSTALLED]) return;
+  req[INSTALLED] = true;
+  lockField(req, 'body', RAW_BODY);
+  lockField(req, 'query', RAW_QUERY);
+  lockField(req, 'params', RAW_PARAMS);
+}
+
+function lockField(req, field, symbol) {
+  // preserve a value assigned before lockdown was installed
+  if (Object.prototype.hasOwnProperty.call(req, field)) {
+    req[symbol] = req[field];
+    delete req[field];
+  }
+  Object.defineProperty(req, field, {
+    configurable: true,
+    enumerable: false,
+    get: function () {
+      report(this, field);
+      return this[symbol]; // only reached in 'warn' mode
+    },
+    set: function (value) {
+      this[symbol] = value;
+    },
+  });
+}
+
+/**
+ * Effective params/query for express internals: the raw fields once lockdown
+ * is installed, the plain properties otherwise.
+ */
+function getParams(req) {
+  return req[INSTALLED] ? req[RAW_PARAMS] : req.params;
+}
+
+function getQuery(req) {
+  return req[INSTALLED] ? req[RAW_QUERY] : req.query;
+}
+
+/**
+ * Property key under which the router saves/restores params on the request.
+ */
+function paramsProp(req) {
+  return req[INSTALLED] ? RAW_PARAMS : 'params';
+}
+
+module.exports = {
+  RAW_BODY: RAW_BODY,
+  RAW_QUERY: RAW_QUERY,
+  RAW_PARAMS: RAW_PARAMS,
+  INSTALLED: INSTALLED,
+  mode: mode,
+  setModeForTests: setModeForTests,
+  install: install,
+  getParams: getParams,
+  getQuery: getQuery,
+  paramsProp: paramsProp,
+};
